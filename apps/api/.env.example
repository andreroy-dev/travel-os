# Copy to .env for local development. Production values live in the host's dashboard.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./travelos.db
JWT_SECRET=                     # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_ENCRYPTION_KEY=           # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# Real sign-in (Supabase Auth). SUPABASE_URL enables asymmetric-key tokens;
# SUPABASE_JWT_SECRET only for projects still on the legacy shared secret.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
DEV_LOGIN_ENABLED=true          # email-only sign-in; always off when ENVIRONMENT=production

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8002/api/v1/integrations/gmail/callback

OPENAI_API_KEY=
